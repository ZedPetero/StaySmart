<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="application.LoginController"
            prefWidth="420.0" prefHeight="300.0"
            stylesheets="@application.css">

    <children>
        <VBox alignment="CENTER" spacing="14.0"
              AnchorPane.topAnchor="20.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0"
              AnchorPane.bottomAnchor="20.0">

            <children>

                <!-- Title -->
                <Label text="Welcome" styleClass="title-label" />

                <!-- Optional logo -->
                <ImageView fitWidth="64.0" fitHeight="64.0" pickOnBounds="true" preserveRatio="true" />

                <!-- Login form -->
                <VBox spacing="8.0" styleClass="card" alignment="CENTER_LEFT">
                    <padding>
  						<Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
					</padding>


                    <children>

                        <!-- Username / Password grid -->
                        <GridPane hgap="8.0" vgap="8.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="30.0"/>
                                <ColumnConstraints percentWidth="70.0"/>
                            </columnConstraints>

                            <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="usernameField" promptText="Enter username"
                                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <PasswordField fx:id="passwordField" promptText="Enter password"
                                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        </GridPane>

                        <!-- Remember + Forgot -->
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children>
                                <CheckBox fx:id="rememberCheck" text="Remember me" />
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Forgot?" onAction="#onForgot" styleClass="link-button" />
                            </children>
                        </HBox>

                        <!-- Buttons -->
                        <HBox spacing="10.0" alignment="CENTER_RIGHT">
                            <children>
                                <Button text="Cancel" onAction="#onCancel"/>
                                <Button fx:id="loginButton" text="Login" onAction="#onLogin" defaultButton="true"/>
                            </children>
                        </HBox>

                    </children>
                </VBox>

            </children>

        </VBox>
    </children>

</AnchorPane>
