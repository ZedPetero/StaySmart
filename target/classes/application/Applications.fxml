<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<VBox spacing="20" styleClass="main-content" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <VBox style="-fx-padding: 30 50 20 50;">
        <Label text="Applications" styleClass="header-title" style="-fx-text-fill: #1a1a1a;"/>
        <Label text="Review and approve new tenant requests." styleClass="welcome-subtitle"/>
    </VBox>

    <VBox style="-fx-padding: 0 50 50 50;" spacing="15">
        <HBox styleClass="activity-card" spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
            <StackPane styleClass="icon-bg-orange">
                <ImageView fitWidth="25" fitHeight="25" preserveRatio="true">
                    <image><Image url="@images/document-signed.png"/></image>
                </ImageView>
            </StackPane>
            <VBox HBox.hgrow="ALWAYS">
                <Label text="Application from John Doe" styleClass="activity-main-text"/>
                <Label text="Unit 301 - Modern Apartment" styleClass="activity-sub-text"/>
            </VBox>
            <Button text="View Details" style="-fx-background-color: #EBF5FF; -fx-text-fill: #0061F2; -fx-background-radius: 5; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</VBox>