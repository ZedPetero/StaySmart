<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>


<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<VBox styleClass="application-card" spacing="15" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="application.ApplicationCardController">
    <HBox alignment="CENTER_LEFT">
        <VBox spacing="2">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="lblPropertyName" text="Property Name" styleClass="app-card-title" />
                <Label fx:id="lblType" text="Booking" styleClass="type-badge" />
            </HBox>
            <Label fx:id="lblApplyDate" text="Applied on: Just now" styleClass="app-card-subtitle" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblStatus" text="Pending" styleClass="badge-pending" />
    </HBox>

    <HBox fx:id="boxPayment" styleClass="payment-box" alignment="CENTER_LEFT" spacing="15">
        <ImageView fx:id="imgPaymentIcon" fitHeight="20" fitWidth="20" pickOnBounds="true"
            preserveRatio="true">
            <image>
                <Image url="@images/icon-wallet.png" />
            </image>
        </ImageView>

        <Label fx:id="lblPayment" text="Payment Method: GCash" styleClass="payment-text" />
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="btnMessage" text="Message Landlord" onAction="#handleMessage"
            styleClass="btn-message" graphicTextGap="10">
            <!-- If image exists, add graphic here, otherwise just text -->
        </Button>
    </HBox>
</VBox>