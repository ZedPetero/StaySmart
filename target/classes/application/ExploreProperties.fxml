<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<ScrollPane fitToWidth="true"
            style="-fx-background-color: transparent; -fx-background: transparent;"
            stylesheets="@ExploreRooms.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="application.ExplorePropertiesController">

    <content>
        <VBox spacing="25" style="-fx-background-color: transparent;">
            <padding>
                <Insets top="20" right="40" bottom="40" left="40"/>
            </padding>

            <VBox spacing="5">
                <Label text="Explore Properties" style="-fx-font-family: 'Outfit'; -fx-font-weight: bold; -fx-font-size: 24px; -fx-text-fill: black;"/>
                <Label text="Find your perfect home from all available listings" style="-fx-font-family: 'Outfit'; -fx-font-size: 16px; -fx-text-fill: #7d8da1;"/>
            </VBox>

            <HBox styleClass="search-bar-container" spacing="15" alignment="CENTER_LEFT">

                <HBox styleClass="search-input" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" prefHeight="45">
                    <padding><Insets left="15"/></padding>
                    <ImageView fitHeight="20" fitWidth="20" opacity="0.5">
                        <Image url="@images/location-crosshairs.png"/>
                    </ImageView>

                    <TextField fx:id="txtSearch"
                               onAction="#handleSearch"
                               promptText="Search for location, property name..."
                               style="-fx-background-color: transparent; -fx-text-fill: white; -fx-prompt-text-fill: #e6eef5; -fx-font-size: 16px;"
                               HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox styleClass="filter-button" prefHeight="45" prefWidth="180" alignment="CENTER">
                    <Label text="Recommended"/>
                </HBox>

                <HBox styleClass="filter-button" prefHeight="45" prefWidth="120" alignment="CENTER" spacing="10">
                    <ImageView fitHeight="18" fitWidth="18">
                        <Image url="@images/settings.png"/>
                    </ImageView>
                    <Label text="Filter"/>
                </HBox>
            </HBox>

            <GridPane fx:id="propertiesGrid" hgap="30" vgap="30">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                </columnConstraints>
            </GridPane>

            <VBox fx:id="emptyStateBox" alignment="CENTER" spacing="15" visible="false" managed="false">
                <padding><Insets top="50"/></padding>
                <ImageView fitWidth="80" fitHeight="80" preserveRatio="true" opacity="0.5">
                    <image><Image url="@images/building.png"/></image>
                </ImageView>
                <Label text="No properties found" style="-fx-font-family: 'Outfit Bold'; -fx-font-size: 20px; -fx-text-fill: #999;"/>
                <Label text="Try adjusting your search terms." style="-fx-font-family: 'Outfit Regular'; -fx-font-size: 14px; -fx-text-fill: #999;"/>
            </VBox>

        </VBox>
    </content>
</ScrollPane>