<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.RoomEditorController">
    <children>
        <VBox alignment="TOP_CENTER" prefHeight="700.0" prefWidth="500.0" spacing="15.0" style="-fx-background-color: #d5ebf9; -fx-background-radius: 20; -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 5); -fx-padding: 30;">
            <children>
                <Label alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" text="Room Details" textFill="#154360">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Label>

                <VBox spacing="12.0">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label prefWidth="120.0" text="Room Number:" textFill="#154360">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextField fx:id="txtRoomNumber" editable="false" promptText="101" style="-fx-background-color: #AED6F1; -fx-background-radius: 5;" HBox.hgrow="ALWAYS" />
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label prefWidth="120.0" text="Price (Monthly):" textFill="#154360">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextField fx:id="txtPrice" promptText="0.00" style="-fx-background-color: #AED6F1; -fx-background-radius: 5;" HBox.hgrow="ALWAYS" />
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label prefWidth="120.0" text="Status:" textFill="#154360">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <ComboBox fx:id="comboStatus" prefWidth="200.0" style="-fx-background-color: #AED6F1; -fx-background-radius: 5;" />
                    </HBox>

                    <HBox alignment="TOP_LEFT" spacing="10.0">
                        <Label prefWidth="120.0" text="Facilities:" textFill="#154360">
                            <font><Font name="System Bold" size="13.0" /></font>
                            <padding><Insets top="5.0" /></padding>
                        </Label>

                        <VBox spacing="8.0" style="-fx-border-color: #85C1E9; -fx-border-radius: 10; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                            <children>
                                <CheckBox fx:id="chkFan" text="Electric fan" textFill="#154360" />
                                <CheckBox fx:id="chkAC" text="Air-conditioned unit" textFill="#154360" />
                                <CheckBox fx:id="chkCurtains" text="Curtain / Window blinds" textFill="#154360" />
                                <CheckBox fx:id="chkCabinet" text="Cabinet / Closet" textFill="#154360" />
                                <CheckBox fx:id="chkTable" text="Study table / Desk" textFill="#154360" />
                                <CheckBox fx:id="chkHooks" text="Wall hooks / Hangers" textFill="#154360" />
                                <CheckBox fx:id="chkOutlets" text="Electrical outlets" textFill="#154360" />
                                <CheckBox fx:id="chkExtension" text="Extension cord (fixed)" textFill="#154360" />
                                <CheckBox fx:id="chkSubmeter" text="Own electric sub-meter" textFill="#154360" />
                                <CheckBox fx:id="chkSmoke" text="Smoke detector" textFill="#154360" />
                                <HBox alignment="CENTER_LEFT" spacing="5.0">
                                    <CheckBox fx:id="chkOther" text="Other:" textFill="#154360" />
                                    <TextField fx:id="txtOther" promptText="Specify..." style="-fx-background-color: transparent; -fx-border-color: transparent transparent #154360 transparent;" />
                                </HBox>
                            </children>
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label prefWidth="120.0" text="Room Image:" textFill="#154360">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <VBox HBox.hgrow="ALWAYS" spacing="5">
                            <Button text="Choose Image..." onAction="#handleChooseImage" style="-fx-background-color: #AED6F1; -fx-text-fill: #154360;"/>
                            <Label fx:id="lblImagePath" text="No file selected" style="-fx-font-size: 10px;" textFill="#555"/>
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER">
                        <ImageView fx:id="imgPreview" fitHeight="100.0" fitWidth="200.0" preserveRatio="true" />
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label prefWidth="120.0" text="Payment:" textFill="#154360">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <CheckBox fx:id="chkPaid" text="Paid this Month" textFill="#154360">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </CheckBox>
                    </HBox>
                </VBox>

                <HBox alignment="BOTTOM_RIGHT" spacing="15.0" VBox.vgrow="ALWAYS">
                    <Button mnemonicParsing="false" onAction="#handleCancel" style="-fx-background-color: #AED6F1; -fx-text-fill: #154360; -fx-background-radius: 5; -fx-font-weight: bold; -fx-cursor: hand;" text="Cancel" />
                    <Button defaultButton="true" mnemonicParsing="false" onAction="#handleSave" style="-fx-background-color: #154360; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-cursor: hand;" text="Save Room" />
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>