<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainBorderPane"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="application.LandlordLayoutController"
    prefWidth="1440" prefHeight="1024"
    stylesheets="@LandlordDashboard.css">

    <left>
        <VBox prefWidth="250" styleClass="sidebar">
            <padding>
                <Insets top="30" right="20" bottom="20" left="20" />
            </padding>
            <spacing>30</spacing>

            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="logo-area">
                <ImageView fitWidth="30" fitHeight="30" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@images/homeicon.png" />
                    </image>
                </ImageView>
                <Label text="STAY SMART" styleClass="logo-text" />
            </HBox>

            <VBox spacing="10" styleClass="menu-area">
                <HBox fx:id="btnOverview" alignment="CENTER_LEFT" spacing="10"
                    styleClass="menu-item" onMouseClicked="#handleShowOverview">
                    <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                        <image>
                            <Image url="@images/menu-burger.png" />
                        </image>
                    </ImageView>
                    <Label text="Overview" styleClass="menu-text" />
                </HBox>

                <HBox fx:id="btnProperties" alignment="CENTER_LEFT" spacing="10"
                    styleClass="menu-item" onMouseClicked="#handleShowProperties">
                    <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                        <image>
                            <Image url="@images/building.png" />
                        </image>
                    </ImageView>
                    <Label text="My Properties" styleClass="menu-text" />
                </HBox>

                <HBox fx:id="btnApplications" alignment="CENTER_LEFT" spacing="10"
                    styleClass="menu-item" onMouseClicked="#handleShowApplications">
                    <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                        <image>
                            <Image url="@images/document-signed.png" />
                        </image>
                    </ImageView>
                    <Label text="Applications" styleClass="menu-text" />
                </HBox>

                <HBox fx:id="btnTenants" alignment="CENTER_LEFT" spacing="10" styleClass="menu-item"
                    onMouseClicked="#handleShowTenants">
                    <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                        <image>
                            <Image url="@images/users.png" />
                        </image>
                    </ImageView>
                    <Label text="Tenants" styleClass="menu-text" />
                </HBox>

                <HBox fx:id="btnMessages" alignment="CENTER_LEFT" spacing="10"
                    styleClass="menu-item" onMouseClicked="#handleShowMessages">
                    <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                        <image>
                            <Image url="@images/bubble-discussion.png" />
                        </image>
                    </ImageView>
                    <Label text="Message" styleClass="menu-text" />
                </HBox>

                <HBox fx:id="btnSettings" alignment="CENTER_LEFT" spacing="10"
                    styleClass="menu-item" onMouseClicked="#handleShowSettings">
                    <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                        <image>
                            <Image url="@images/settings.png" />
                        </image>
                    </ImageView>
                    <Label text="Settings" styleClass="menu-text" />
                </HBox>

                <HBox fx:id="btnLogout" alignment="CENTER_LEFT" spacing="10" styleClass="menu-item"
                    onMouseClicked="#handleLogout">
                    <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                        <image>
                            <Image url="@images/sign-out-alt.png" />
                        </image>
                    </ImageView>
                    <Label text="Logout" styleClass="menu-text" />
                </HBox>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="0" style="-fx-background-color: white;">

            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar">
                <padding>
                    <Insets top="20" right="40" bottom="20" left="40" />
                </padding>

                <Label text="LandLord" styleClass="badge-landlord" />

                <Region HBox.hgrow="ALWAYS" />

                <Button styleClass="btn-add-property" onAction="#handleGlobalAddProperty">
                    <graphic>
                        <HBox alignment="CENTER" spacing="8">
                            <Label text="+" styleClass="btn-add-symbol" />
                            <Label text="Add Property" styleClass="btn-add-text" />
                        </HBox>
                    </graphic>
                </Button>
            </HBox>

            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent;">
            </StackPane>

        </VBox>
    </center>

</BorderPane>