<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="settings-content-card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.SettingsAccountController">

    <VBox spacing="5.0">
        <Label styleClass="card-header" text="Account Settings" />
        <Label styleClass="text-caption" text="Manage your account security and preferences" />
    </VBox>

    <VBox maxWidth="600.0" spacing="25.0" styleClass="inner-card-white">

        <Label styleClass="form-section-title" text="Change Password" />

        <VBox spacing="8.0">
            <Label styleClass="input-label-grey" text="Current Password" />
            <PasswordField fx:id="txtCurrentPass" promptText="Enter current password" styleClass="input-field-blue" />
        </VBox>

        <VBox spacing="8.0">
            <Label styleClass="input-label-grey" text="New Password" />
            <PasswordField fx:id="txtNewPass" promptText="Enter new password" styleClass="input-field-blue" />
        </VBox>

        <VBox spacing="8.0">
            <Label styleClass="input-label-grey" text="Confirm New Password" />
            <PasswordField fx:id="txtConfirmPass" promptText="Confirm new password" styleClass="input-field-blue" />
        </VBox>

        <Button onAction="#handleUpdatePassword" styleClass="btn-primary" text="Update Password">
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin></Button>

    </VBox>
</VBox>