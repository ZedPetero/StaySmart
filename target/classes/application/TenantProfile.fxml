<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="application.TenantProfileController"
            fitToWidth="true"
            style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0; -fx-background-insets: 0;"
            stylesheets="@TenantProfile.css">

    <content>
        <VBox spacing="25" style="-fx-background-color: transparent;">
            <padding><Insets top="0" right="0" bottom="50" left="0"/></padding>
            <Region prefHeight="10" />

            <VBox spacing="5">
                <Label text="My Profile" styleClass="page-title"/>
                <Label text="Manage your personal information and documents" styleClass="page-subtitle"/>
            </VBox>

            <HBox spacing="30" alignment="TOP_LEFT">

                <VBox styleClass="profile-card-left" alignment="TOP_CENTER" spacing="20" prefWidth="340" minWidth="340">
                    <padding><Insets top="40" right="30" bottom="40" left="30"/></padding>

                    <VBox alignment="CENTER" spacing="8" onMouseClicked="#handleUploadPhoto" style="-fx-cursor: hand;">
                        <ImageView fx:id="profileImage" fitWidth="180" fitHeight="180" preserveRatio="false">
                            <clip>
                                <Circle centerX="90" centerY="90" radius="90"/>
                            </clip>
                            <image>
                                <Image url="@images/profile.png"/>
                            </image>
                        </ImageView>
                        <Label text="Click to Change" style="-fx-text-fill: #666; -fx-font-size: 12px; -fx-underline: true;"/>
                    </VBox>

                    <Label fx:id="lblSideName" text="Loading..." styleClass="profile-name" wrapText="true" textAlignment="CENTER"/>

                    <Separator styleClass="profile-separator"/>

                    <GridPane hgap="30" vgap="25" alignment="CENTER">
                        <columnConstraints>
                            <ColumnConstraints halignment="CENTER" minWidth="100"/>
                            <ColumnConstraints halignment="CENTER" minWidth="100"/>
                        </columnConstraints>

                        <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="0" styleClass="stat-number"/>
                            <Label text="Applications Sent" styleClass="stat-label" wrapText="true"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="0" styleClass="stat-number"/>
                            <Label text="Properties Viewed" styleClass="stat-label" wrapText="true"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="0" styleClass="stat-number"/>
                            <Label text="Saved Properties" styleClass="stat-label" wrapText="true"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="0" styleClass="stat-number"/>
                            <Label text="Profile Views" styleClass="stat-label" wrapText="true"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <VBox HBox.hgrow="ALWAYS" spacing="25">

                    <HBox styleClass="tabs-container-right" alignment="CENTER_LEFT" spacing="0">
                        <Button fx:id="btnTabPersonal" text="Personal Info" onAction="#switchTabPersonal"
                                styleClass="tab-btn-right, tab-active-right" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnTabEmergency" text="Emergency Contact" onAction="#switchTabEmergency"
                                styleClass="tab-btn-right" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <StackPane>

                        <VBox fx:id="viewPersonal" styleClass="info-card-right" spacing="25">
                            <padding><Insets top="30" right="40" bottom="40" left="40"/></padding>

                            <HBox alignment="CENTER_LEFT">
                                <Label text="Personal Information" styleClass="info-card-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnEdit" text="Edit Profile" styleClass="btn-edit-profile" onAction="#handleEditToggle">
                                    <graphic>
                                        <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                                            <image><Image url="@images/icon-edit.png"/></image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                            </HBox>

                            <GridPane hgap="30" vgap="20">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                </columnConstraints>

                                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Full Name" styleClass="field-label"/>
                                    <TextField fx:id="txtFullName" styleClass="info-textfield" editable="false"/>
                                </VBox>
                                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Email Address" styleClass="field-label"/>
                                    <TextField fx:id="txtEmail" styleClass="info-textfield" editable="false"/>
                                </VBox>
                                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label text="Phone Number" styleClass="field-label"/>
                                    <TextField fx:id="txtPhone" styleClass="info-textfield" editable="false"/>
                                </VBox>
                                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label text="Current Address" styleClass="field-label"/>
                                    <TextField fx:id="txtAddress" styleClass="info-textfield" editable="false"/>
                                </VBox>
                            </GridPane>

                            <VBox spacing="10">
                                <Label text="About Me" styleClass="info-card-title"/>
                                <VBox styleClass="about-me-box">
                                    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
                                    <TextArea fx:id="txtAboutMe" wrapText="true" editable="false"
                                              style="-fx-background-color: transparent; -fx-control-inner-background: transparent;"
                                              prefRowCount="3"/>
                                </VBox>
                            </VBox>
                        </VBox>

                        <VBox fx:id="viewEmergency" visible="false" styleClass="info-card-right" spacing="25">
                            <padding><Insets top="30" right="40" bottom="40" left="40"/></padding>

                            <HBox alignment="CENTER_LEFT">
                                <Label text="Emergency Contact" styleClass="info-card-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnEditEmergency" text="Edit" styleClass="btn-edit-profile" onAction="#handleEditEmergencyToggle">
                                    <graphic>
                                        <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                                            <image><Image url="@images/icon-edit.png"/></image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                            </HBox>

                            <GridPane hgap="30" vgap="20">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                </columnConstraints>

                                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Contact Name" styleClass="field-label"/>
                                    <TextField fx:id="txtEmName" promptText="Full Name" styleClass="info-textfield" editable="false"/>
                                </VBox>

                                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Contact Phone" styleClass="field-label"/>
                                    <TextField fx:id="txtEmPhone" promptText="09XX XXX XXXX" styleClass="info-textfield" editable="false"/>
                                </VBox>

                                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                                    <Label text="Relationship" styleClass="field-label"/>
                                    <TextField fx:id="txtEmRelation" promptText="e.g. Parent, Guardian, Sibling" styleClass="info-textfield" editable="false"/>
                                </VBox>
                            </GridPane>

                            <VBox styleClass="warning-box-yellow" spacing="10">
                                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                                <Label text="Why We Need this Information" style="-fx-font-weight: bold; -fx-text-fill: #113970; -fx-font-size: 14px;"/>
                                <Label text="Emergency contact information is required by landlords to ensure your safety and provide a point of contact in case of emergencies. This information is kept confidential and only shared with landlords after your application is approved."
                                       wrapText="true" style="-fx-text-fill: #113970;"/>
                            </VBox>
                        </VBox>

                    </StackPane>

                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>