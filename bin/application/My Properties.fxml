<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<VBox spacing="0" styleClass="main-content"
      style="-fx-background-color: transparent;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="application.MyPropertiesController">

    <StackPane VBox.vgrow="ALWAYS">

        <padding>
            <Insets top="30" right="40" bottom="40" left="40"/>
        </padding>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;">
            <content>
                <VBox spacing="20">
                    <VBox spacing="5">
                        <Label text="My Properties" styleClass="page-title" style="-fx-font-family: 'Outfit Bold'; -fx-font-size: 24px; -fx-text-fill: #113970;"/>
                        <Label text="Manage your portfolio" styleClass="page-subtitle" style="-fx-font-family: 'Outfit Regular'; -fx-font-size: 14px; -fx-text-fill: #666;"/>
                    </VBox>

                    <GridPane fx:id="propertiesGrid" hgap="20" vgap="20">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        </columnConstraints>
                    </GridPane>
                </VBox>
            </content>
        </ScrollPane>

        <VBox fx:id="emptyStateBox" alignment="CENTER" spacing="15" visible="false" managed="false">
            <ImageView fitWidth="80" fitHeight="80" preserveRatio="true" opacity="0.5">
                <image><Image url="@images/building.png"/></image>
            </ImageView>
            <Label text="You have no properties registered" style="-fx-font-family: 'Outfit Bold'; -fx-font-size: 20px; -fx-text-fill: #999;"/>
            <Label text="Click '+ Add Property' in the top bar to get started." style="-fx-font-family: 'Outfit Regular'; -fx-font-size: 14px; -fx-text-fill: #999;"/>
        </VBox>

    </StackPane>

</VBox>