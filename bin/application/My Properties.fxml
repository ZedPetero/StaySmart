<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<VBox spacing="0" styleClass="main-content"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="application.MyPropertiesController">

    <StackPane alignment="CENTER_LEFT">

        <Region styleClass="header-background-rectangle" />

        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 0 50 0 50;">

            <VBox alignment="CENTER_LEFT">
                <Label text="My Properties" styleClass="header-title" style="-fx-text-fill: #113970; -fx-font-size: 24px;"/>
                <Label text="Manage your portfolio" styleClass="welcome-subtitle" style="-fx-font-size: 14px;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button text="+ Add Property" styleClass="add-property-button"/>
        </HBox>
    </StackPane>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
        <content>
            <GridPane fx:id="propertiesGrid" hgap="20" vgap="20" style="-fx-padding: 30 50 50 50;">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                </columnConstraints>
            </GridPane>
        </content>
    </ScrollPane>

</VBox>