<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<VBox spacing="30" styleClass="main-content"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets top="40" right="60" bottom="40" left="60"/>
    </padding>

    <VBox spacing="5">
        <Label text="Tenants" styleClass="page-title"/>
        <Label text="Manage your current tenants" styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="20">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Total Tenants" styleClass="stat-label"/>
            <Label text="4" styleClass="stat-value-black"/>
        </VBox>

        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Paid This Month" styleClass="stat-label"/>
            <Label text="2" styleClass="stat-value-green"/>
        </VBox>

        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Pending Payment" styleClass="stat-label"/>
            <Label text="1" styleClass="stat-value-red"/>
        </VBox>

        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Overdue" styleClass="stat-label"/>
            <Label text="1" styleClass="stat-value-red"/>
        </VBox>
    </HBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;">
        <content>
            <VBox fx:id="tenantListContainer" spacing="20" style="-fx-background-color: transparent;">
                <padding><Insets top="10" right="10" bottom="10" left="5"/></padding>

                <VBox styleClass="tenant-card" spacing="25">

                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <StackPane>
                            <Circle radius="30" fill="WHITE" stroke="#e0e0e0"/>
                            <ImageView fitWidth="35" fitHeight="35" preserveRatio="true">
                                <image><Image url="@images/profile.png"/></image>
                            </ImageView>
                        </StackPane>

                        <VBox spacing="3" alignment="CENTER_LEFT">
                            <Label text="Shayne Digo" styleClass="tenant-name"/>
                            <Label text="shaynedigo31@gmail.com" styleClass="tenant-email"/>
                            <Label text="+63 0951 382 4834" styleClass="tenant-phone"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button style="-fx-background-color: transparent; -fx-cursor: hand;">
                            <graphic><Label text="⋮" style="-fx-font-size: 24px; -fx-text-fill: #7e8b94;"/></graphic>
                        </Button>
                    </HBox>

                    <HBox spacing="20">
                        <HBox styleClass="info-box-gray" HBox.hgrow="ALWAYS" maxWidth="Infinity" alignment="CENTER_LEFT" spacing="15">
                            <ImageView fitWidth="24" fitHeight="24" opacity="0.5"><image><Image url="@images/icon-location.png"/></image></ImageView>
                            <VBox spacing="2">
                                <Label text="Property" styleClass="info-label-small"/>
                                <Label text="Cozy Student Room" styleClass="info-value-black"/>
                            </VBox>
                        </HBox>

                        <HBox styleClass="info-box-gray" HBox.hgrow="ALWAYS" maxWidth="Infinity" alignment="CENTER_LEFT" spacing="15">
                            <ImageView fitWidth="24" fitHeight="24" opacity="0.5"><image><Image url="@images/icon-calendar.png"/></image></ImageView>
                            <VBox spacing="2">
                                <Label text="Move-in Date" styleClass="info-label-small"/>
                                <Label text="Jan 15, 2025" styleClass="info-value-black"/>
                            </VBox>
                        </HBox>
                    </HBox>

                    <HBox styleClass="rent-status-bar" alignment="CENTER_LEFT" spacing="20">
                        <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>

                        <VBox spacing="2">
                            <Label text="Monthly Rent" styleClass="info-label-small"/>
                            <Label text="₱2,800" styleClass="rent-price-text"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <VBox alignment="CENTER_RIGHT" spacing="5">
                            <Label text="Next Payment" styleClass="info-label-small"/>
                            <HBox alignment="CENTER_RIGHT" spacing="10">
                                <Label text="Feb 15, 2025" styleClass="info-value-black"/>
                                <Label text="Paid" styleClass="status-badge-green"/>
                            </HBox>
                        </VBox>
                    </HBox>

                    <HBox spacing="20">
                        <Button text="Contact Tenant" styleClass="btn-outline-blue" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="View Details" styleClass="btn-filled-blue" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>

                </VBox>
            </VBox>
        </content>
    </ScrollPane>
</VBox>