<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fitToWidth="true"
            style="-fx-background-color: transparent; -fx-background: transparent;"
            stylesheets="@ExploreRooms.css">

    <content>
        <VBox spacing="25" style="-fx-background-color: transparent;">
            <padding><Insets top="20" right="40" bottom="40" left="40"/></padding>

            <VBox spacing="5">
                <Label text="Explore Boarding House" style="-fx-font-family: 'Outfit'; -fx-font-weight: bold; -fx-font-size: 24px; -fx-text-fill: black;"/>
                <Label text="Find your perfect room from available listings" style="-fx-font-family: 'Outfit'; -fx-font-size: 16px; -fx-text-fill: #7d8da1;"/>
            </VBox>

            <HBox styleClass="search-bar-container" spacing="15" alignment="CENTER_LEFT">
                <HBox styleClass="search-input" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" prefHeight="45">
                    <padding><Insets left="15"/></padding>
                    <ImageView fitHeight="20" fitWidth="20" opacity="0.5"><Image url="@images/location-crosshairs.png"/></ImageView>
                    <TextField promptText="Search for location, property name..."
                               style="-fx-background-color: transparent; -fx-text-fill: white; -fx-prompt-text-fill: #e6eef5; -fx-font-size: 16px;"
                               HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox styleClass="filter-button" prefHeight="45" prefWidth="180" alignment="CENTER">
                    <Label text="Recommended"/>
                </HBox>

                <HBox styleClass="filter-button" prefHeight="45" prefWidth="120" alignment="CENTER" spacing="10">
                    <ImageView fitHeight="18" fitWidth="18"><Image url="@images/settings.png"/></ImageView>
                    <Label text="Filter"/>
                </HBox>
            </HBox>

            <FlowPane hgap="30" vgap="30" prefWrapLength="1000">

                <VBox styleClass="room-card" prefWidth="300" minHeight="400">

                    <StackPane alignment="TOP_LEFT" prefHeight="180" styleClass="room-image-placeholder">

                        <ImageView fitWidth="300" fitHeight="180" preserveRatio="false">
                            <image>
                                <Image url="@images/sampleroom1.jpg"/>
                            </image>
                        </ImageView>

                        <HBox styleClass="status-badge" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity">
                            <StackPane.margin><Insets top="15" left="15"/></StackPane.margin>
                            <Label text="Available" styleClass="status-text"/>
                        </HBox>
                    </StackPane>

                    <VBox spacing="10">
                        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

                        <Label text="Cozy Student Room" styleClass="room-title"/>
                        <Label text="₱2,800/month" styleClass="room-price"/>
                        <Label text="UM Matina Drive, Davao" styleClass="room-location"/>

                        <HBox spacing="10">
                            <HBox styleClass="amenity-tag"><Label text="WiFi" styleClass="amenity-text"/></HBox>
                            <HBox styleClass="amenity-tag"><Label text="Aircon" styleClass="amenity-text"/></HBox>
                            <HBox styleClass="amenity-tag"><Label text="Own CR" styleClass="amenity-text"/></HBox>
                        </HBox>

                        <Region prefHeight="10"/>
                        <Button text="View Details" maxWidth="Infinity" styleClass="btn-view-details" prefHeight="40"/>
                    </VBox>
                </VBox>

                <VBox styleClass="room-card" prefWidth="300" minHeight="400">

                    <StackPane alignment="TOP_LEFT" prefHeight="180" styleClass="room-image-placeholder">
                        <ImageView fitWidth="300" fitHeight="180" preserveRatio="false">
                            <image>
                                <Image url="@images/sampleroom2.jpg"/>
                            </image>
                        </ImageView>

                        <HBox styleClass="status-badge" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity">
                            <StackPane.margin><Insets top="15" left="15"/></StackPane.margin>
                            <Label text="Available" styleClass="status-text"/>
                        </HBox>
                    </StackPane>

                    <VBox spacing="10">
                        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                        <Label text="Modern Boarding House" styleClass="room-title"/>
                        <Label text="₱3,500/month" styleClass="room-price"/>
                        <Label text="Sandawa, Davao City" styleClass="room-location"/>
                        <HBox spacing="10">
                            <HBox styleClass="amenity-tag"><Label text="Kitchen" styleClass="amenity-text"/></HBox>
                        </HBox>
                        <Region prefHeight="10"/>
                        <Button text="View Details" maxWidth="Infinity" styleClass="btn-view-details" prefHeight="40"/>
                    </VBox>
                </VBox>

                <VBox styleClass="room-card" prefWidth="300" minHeight="400">

                    <StackPane alignment="TOP_LEFT" prefHeight="180" styleClass="room-image-placeholder">
                        <ImageView fitWidth="300" fitHeight="180" preserveRatio="false">
                            <image>
                                <Image url="@images/sampleroom3.jpg"/>
                            </image>
                        </ImageView>

                        <HBox styleClass="status-badge" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity">
                            <StackPane.margin><Insets top="15" left="15"/></StackPane.margin>
                            <Label text="Available" styleClass="status-text"/>
                        </HBox>
                    </StackPane>

                    <VBox spacing="10">
                        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                        <Label text="Affordable Studio Type" styleClass="room-title"/>
                        <Label text="₱4,200/month" styleClass="room-price"/>
                        <Label text="Maa Crossing, Davao City" styleClass="room-location"/>
                        <HBox spacing="10">
                            <HBox styleClass="amenity-tag"><Label text="WiFi" styleClass="amenity-text"/></HBox>
                            <HBox styleClass="amenity-tag"><Label text="Kitchen" styleClass="amenity-text"/></HBox>
                            <HBox styleClass="amenity-tag"><Label text="Laundry" styleClass="amenity-text"/></HBox>
                        </HBox>
                        <Region prefHeight="10"/>
                        <Button text="View Details" maxWidth="Infinity" styleClass="btn-view-details" prefHeight="40"/>
                    </VBox>
                </VBox>

            </FlowPane>
        </VBox>
    </content>
</ScrollPane>