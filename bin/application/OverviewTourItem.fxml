<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns:fx="http://javafx.com/fxml/1" fx:id="tourRow"
      style="-fx-background-color: #d1dfe8; -fx-background-radius: 15;"
      alignment="CENTER_LEFT" prefHeight="110">
    <padding><Insets top="15" right="20" bottom="15" left="25"/></padding>

    <VBox spacing="5" HBox.hgrow="ALWAYS">
        <Label fx:id="lblPropertyName" text="Property Name"
               style="-fx-font-family: 'Outfit'; -fx-font-weight: normal; -fx-font-size: 18px; -fx-text-fill: #5b5656;"/>

        <HBox spacing="30" alignment="CENTER_LEFT">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Rectangle width="18" height="18" fill="#113970"/>
                <Label fx:id="lblDate" text="Date and Time"
                       style="-fx-font-family: 'Outfit'; -fx-font-size: 16px; -fx-text-fill: #5b5656;"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Rectangle width="18" height="18" fill="#113970"/>
                <Label fx:id="lblLocation" text="Location"
                       style="-fx-font-family: 'Outfit'; -fx-font-size: 16px; -fx-text-fill: #5b5656;"/>
            </HBox>
        </HBox>

        <Label fx:id="lblHost" text="Host: Landlord Name"
               style="-fx-font-family: 'Outfit'; -fx-font-size: 16px; -fx-text-fill: #5c5656;"/>
    </VBox>

    <Button text="Reschedule"
            style="-fx-background-color: #113970; -fx-text-fill: white; -fx-background-radius: 8;
                   -fx-font-family: 'Outfit'; -fx-font-weight: bold; -fx-font-size: 15px;
                   -fx-padding: 8 20 8 20; -fx-cursor: hand;"/>
</HBox>