<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color: white;" prefHeight="600" prefWidth="450"
            stylesheets="@LandlordDashboard.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="application.AddPropertyController">

    <top>
        <VBox style="-fx-padding: 20 25 20 25; -fx-background-color: white; -fx-border-color: #eee; -fx-border-width: 0 0 1 0;">
            <Label text="Add New Property" styleClass="dialog-title"/>
            <Label text="Fill in the details below to register your building." styleClass="dialog-subtitle"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;">
            <content>
                <VBox spacing="20" style="-fx-padding: 25;">

                    <VBox spacing="15">
                        <Label text="Basic Details" styleClass="section-header"/>

                        <VBox spacing="5">
                            <Label text="Property Name" styleClass="form-label"/>
                            <TextField fx:id="txtName" promptText="e.g. Sunset Apartments" styleClass="input-field"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Location / Address" styleClass="form-label"/>
                            <TextField fx:id="txtLocation" promptText="e.g. 123 Ocean Drive" styleClass="input-field"/>
                        </VBox>

                        <HBox spacing="15">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Monthly Price (₱)" styleClass="form-label"/>
                                <TextField fx:id="txtPrice" promptText="e.g. 1,500" styleClass="input-field"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Location Type" styleClass="form-label"/>
                                <ComboBox fx:id="cmbType" promptText="Select" maxWidth="Infinity" styleClass="input-field"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <Separator />

                    <VBox spacing="15">
                        <Label text="Structure Layout" styleClass="section-header"/>
                        <Label text="Enter floors to generate room inputs." style="-fx-text-fill: #888; -fx-font-size: 12px;" wrapText="true"/>

                        <VBox spacing="5">
                            <Label text="Number of Floors" styleClass="form-label"/>
                            <TextField fx:id="txtFloors" promptText="e.g. 3" styleClass="input-field"/>
                        </VBox>

                        <VBox fx:id="dynamicRoomContainer" spacing="10" styleClass="dynamic-container"/>
                    </VBox>

                    <Separator />

                    <VBox spacing="10">
                        <Label text="Property Image" styleClass="section-header"/>
                        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #eef0f3; -fx-border-radius: 8;">
                            <Button text="Choose File" onAction="#handleImageUpload" styleClass="upload-button"/>
                            <Label fx:id="lblImageName" text="No file selected" style="-fx-text-fill: #666; -fx-font-style: italic;"/>
                        </HBox>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 20 25 20 25; -fx-background-color: #fcfcfc; -fx-border-color: #eee; -fx-border-width: 1 0 0 0;">
            <Button text="Cancel" onAction="#handleCancel" styleClass="btn-cancel"/>
            <Button text="Save Property" onAction="#handleSave" styleClass="btn-primary"/>
        </HBox>
    </bottom>

</BorderPane>