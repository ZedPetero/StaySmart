<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="add-property-root" prefHeight="750" prefWidth="500"
            stylesheets="@LandlordDashboard.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="application.AddPropertyController">

    <top>
        <VBox styleClass="header-container">
            <Label text="Add New Property" styleClass="dialog-title"/>
            <Label text="Fill in the details below to register your building" styleClass="dialog-subtitle"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="custom-scroll">
            <content>
                <VBox spacing="25" style="-fx-padding: 25;">

                    <VBox spacing="15">
                        <Label text="Basic Details" styleClass="section-header"/>

                        <VBox spacing="5">
                            <Label text="Property Name" styleClass="form-label"/>
                            <TextField fx:id="txtName" styleClass="blue-input-field"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Location/Address" styleClass="form-label"/>
                            <TextField fx:id="txtLocation" styleClass="blue-input-field"/>
                        </VBox>

                        <HBox spacing="15">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Monthly Price" styleClass="form-label"/>
                                <TextField fx:id="txtPrice" styleClass="blue-input-field"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Location Type" styleClass="form-label"/>
                                <ComboBox fx:id="cmbType" promptText="" maxWidth="Infinity" styleClass="blue-input-field"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox spacing="10">
                        <Label text="Structure Layout" styleClass="section-header"/>
                        <Label text="Enter floors to generate room inputs" styleClass="helper-text"/>

                        <VBox spacing="5">
                            <Label text="Number of Floors" styleClass="form-label"/>
                            <TextField fx:id="txtFloors" styleClass="blue-input-field"/>
                        </VBox>

                        <VBox fx:id="dynamicRoomContainer" spacing="10" styleClass="structure-box"/>
                    </VBox>

                    <VBox spacing="10">
                        <Label text="Shared Amenities" styleClass="section-header"/>
                        <GridPane hgap="10" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>

                            <CheckBox text="Toilet &amp; bath" styleClass="blue-checkbox" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <CheckBox text="Kitchen / cooking area" styleClass="blue-checkbox" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <CheckBox text="Refrigerator" styleClass="blue-checkbox" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <CheckBox text="Laundry area" styleClass="blue-checkbox" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <CheckBox text="Washing machine" styleClass="blue-checkbox" GridPane.columnIndex="0" GridPane.rowIndex="4"/>

                            <CheckBox text="CCTV cameras" styleClass="blue-checkbox" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <CheckBox text="Fire extinguisher" styleClass="blue-checkbox" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            <CheckBox text="Emergency exits" styleClass="blue-checkbox" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                            <CheckBox text="Secure main entrance / gate" styleClass="blue-checkbox" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                        </GridPane>
                    </VBox>

                    <VBox spacing="10">
                        <Label text="Property Image" styleClass="section-header"/>
                        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="image-upload-box">
                            <Button text="Choose File" onAction="#handleImageUpload" styleClass="upload-button"/>
                            <Label fx:id="lblImageName" text="No File Selected" styleClass="file-label"/>
                        </HBox>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="15" alignment="CENTER_RIGHT" styleClass="footer-container">
            <Button text="Cancel" onAction="#handleCancel" styleClass="btn-cancel-blue"/>
            <Button text="Save Property" onAction="#handleSave" styleClass="btn-save-blue"/>
        </HBox>
    </bottom>

</BorderPane>