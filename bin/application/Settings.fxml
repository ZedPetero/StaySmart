<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" styleClass="main-content" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <VBox style="-fx-padding: 30 50 20 50;">
        <Label text="Account Settings" styleClass="header-title" style="-fx-text-fill: #1a1a1a;"/>
        <Label text="Manage your profile and preferences." styleClass="welcome-subtitle"/>
    </VBox>

    <VBox spacing="20" style="-fx-padding: 0 50 50 50;">
        <VBox spacing="5">
            <Label text="Full Name" style="-fx-font-weight: bold;"/>
            <TextField promptText="Enter your name" maxWidth="400"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Email Address" style="-fx-font-weight: bold;"/>
            <TextField promptText="email@example.com" maxWidth="400"/>
        </VBox>
        <Button text="Save Changes" style="-fx-background-color: #0061F2; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5;"/>
    </VBox>
</VBox>