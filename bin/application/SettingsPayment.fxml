<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="settings-content-card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.SettingsPaymentController">

    <VBox spacing="5.0">
        <Label styleClass="card-header" text="Payment Settings" />
        <Label styleClass="text-caption" text="Manage your payment methods and billing information" />
    </VBox>

    <VBox maxWidth="600.0" spacing="25.0" styleClass="inner-card-white">

        <Label styleClass="form-section-title" text="E-Wallet Information" />

        <VBox spacing="8.0">
            <Label styleClass="input-label-grey" text="E-Wallet Provider" />
            <TextField fx:id="txtProvider" promptText="Select Provider" styleClass="input-field-blue" />
        </VBox>

        <VBox spacing="8.0">
            <Label styleClass="input-label-grey" text="Mobile Number" />
            <TextField fx:id="txtMobileNumber" promptText="+62 XXXX XXX XXXX" styleClass="input-field-blue" />
        </VBox>

        <Button onAction="#handleSaveEWallet" styleClass="btn-primary" text="Save E-Wallet">
            <VBox.margin>
                <Insets bottom="10.0" />
            </VBox.margin>
        </Button>

        <VBox spacing="10.0" styleClass="info-box-blue">
            <Label styleClass="text-highlight-purple" text="Payment QR Code" />
            <Label styleClass="text-caption" text="Generate a QR code for tenants to easily send payments" wrapText="true"/>

            <Button onAction="#handleGenerateQR" styleClass="btn-primary" text="Generate QR Code">
                <VBox.margin>
                    <Insets top="5.0" />
                </VBox.margin>
            </Button>
        </VBox>

    </VBox>
</VBox>