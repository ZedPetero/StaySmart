<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>

<VBox fx:id="cardContainer"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="application.PropertyCardController"
      style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-cursor: hand;"
      prefWidth="300" minWidth="280" maxWidth="350">

    <StackPane alignment="TOP_RIGHT">
        <ImageView fx:id="propertyImage" fitHeight="160" fitWidth="300" pickOnBounds="true"/>

        <clip>
            <Rectangle width="300" height="160" arcWidth="15" arcHeight="15"/>
        </clip>
    </StackPane>

    <VBox spacing="8" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="12" right="15" bottom="15" left="15"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox HBox.hgrow="ALWAYS">
                <Label fx:id="nameLabel" text="Property Name" style="-fx-font-family: 'Outfit Bold'; -fx-font-size: 16px; -fx-text-fill: #113970;"/>
                <Label fx:id="locationLabel" text="Location" style="-fx-font-family: 'Outfit'; -fx-font-size: 12px; -fx-text-fill: #7d8da1;"/>
            </VBox>
            <Label fx:id="priceLabel" text="0" style="-fx-font-family: 'Outfit Bold'; -fx-font-size: 16px; -fx-text-fill: #27ae60;"/>
        </HBox>

        <Region prefHeight="1" style="-fx-background-color: #f0f0f0;" />

        <HBox spacing="10" VBox.vgrow="ALWAYS">

            <VBox spacing="5" minWidth="80" maxWidth="100">
                <Label text="DETAILS" style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #a0a0a0;"/>

                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Label fx:id="typeLabel" text="Type" style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
                </HBox>

                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Label fx:id="floorsLabel" text="Floors" style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
                </HBox>
            </VBox>

            <Region prefWidth="1" style="-fx-background-color: #f0f0f0;" />

            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="AMENITIES" style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #a0a0a0;"/>
                <FlowPane fx:id="amenitiesContainer" hgap="5" vgap="5" prefWrapLength="150" />
            </VBox>

        </HBox>

        <HBox fx:id="actionBox" spacing="10" alignment="CENTER_RIGHT" visible="false" managed="false">
            <padding><Insets top="5"/></padding>
            <Label text="View Details" style="-fx-text-fill: #113970; -fx-font-size: 11px; -fx-underline: true;"/>
        </HBox>

    </VBox>

</VBox>