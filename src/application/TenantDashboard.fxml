<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="application.TenantDashboardController"
    prefWidth="1280" prefHeight="720"
    styleClass="tenant-dashboard"
    stylesheets="@TenantDashboard.css">

    <AnchorPane styleClass="sidebar" prefWidth="320"
        AnchorPane.leftAnchor="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">

        <VBox spacing="40" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
            AnchorPane.rightAnchor="0">
            <padding>
                <Insets top="40" left="0" right="0" />
            </padding>

            <HBox styleClass="app-title" spacing="15" alignment="CENTER_LEFT">
                <ImageView fitWidth="50" fitHeight="50">
                    <Image url="@images/image-7.png" />
                </ImageView>
                <Label text="SMART STAY" styleClass="app-name" />
            </HBox>

            <VBox styleClass="nav-menu" spacing="10">

                <HBox fx:id="btnDashboard" onMouseClicked="#handleShowDashboard"
                    styleClass="nav-item" spacing="15" alignment="CENTER_LEFT">
                    <ImageView fitWidth="24" fitHeight="24" styleClass="nav-icon">
                        <Image url="@images/menu-burger.png" />
                    </ImageView>
                    <Label text="Dashboard" styleClass="nav-text" />
                </HBox>

                <HBox fx:id="btnExplore" onMouseClicked="#handleShowExplore" styleClass="nav-item"
                    spacing="15" alignment="CENTER_LEFT">
                    <ImageView fitWidth="24" fitHeight="24" styleClass="nav-icon">
                        <Image url="@images/location-crosshairs.png" />
                    </ImageView>
                    <Label text="Explore Rooms" styleClass="nav-text" />
                </HBox>

                <HBox fx:id="btnSaved" onMouseClicked="#handleShowSaved" styleClass="nav-item"
                    spacing="15" alignment="CENTER_LEFT">
                    <ImageView fitWidth="24" fitHeight="24" styleClass="nav-icon">
                        <Image url="@images/heart.png" />
                    </ImageView>
                    <Label text="Saved" styleClass="nav-text" />
                </HBox>

                <HBox fx:id="btnApplications" onMouseClicked="#handleShowApplications"
                    styleClass="nav-item" spacing="15" alignment="CENTER_LEFT">
                    <ImageView fitWidth="24" fitHeight="24" styleClass="nav-icon">
                        <Image url="@images/document-signed.png" />
                    </ImageView>
                    <Label text="Applications" styleClass="nav-text" />
                </HBox>

                <HBox fx:id="btnMessages" onMouseClicked="#handleShowMessages"
                    styleClass="nav-item" spacing="15" alignment="CENTER_LEFT">
                    <ImageView fitWidth="24" fitHeight="24" styleClass="nav-icon">
                        <Image url="@images/bubble-discussion.png" />
                    </ImageView>
                    <Label text="Messages" styleClass="nav-text" />
                </HBox>

                <HBox fx:id="btnProfile" onMouseClicked="#handleShowProfile" styleClass="nav-item"
                    spacing="15" alignment="CENTER_LEFT">
                    <ImageView fitWidth="24" fitHeight="24" styleClass="nav-icon">
                        <Image url="@images/user.png" />
                    </ImageView>
                    <Label text="Profile" styleClass="nav-text" />
                </HBox>

                <HBox fx:id="btnSettings" onMouseClicked="#handleShowSettings" styleClass="nav-item"
                    spacing="15" alignment="CENTER_LEFT">
                    <ImageView fitWidth="24" fitHeight="24" styleClass="nav-icon">
                        <Image url="@images/settings.png" />
                    </ImageView>
                    <Label text="Settings" styleClass="nav-text" />
                </HBox>

                <HBox fx:id="btnLogout" onMouseClicked="#handleLogout" styleClass="nav-item"
                    spacing="15" alignment="CENTER_LEFT">
                    <ImageView fitWidth="24" fitHeight="24" styleClass="nav-icon">
                        <Image url="@images/sign-out-alt.png" />
                    </ImageView>
                    <Label text="Logout" styleClass="nav-text" />
                </HBox>
            </VBox>
        </VBox>
    </AnchorPane>

    <VBox styleClass="background-gradient" spacing="30"
        AnchorPane.leftAnchor="320" AnchorPane.topAnchor="0"
        AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

        <padding>
            <Insets top="30" right="40" bottom="30" left="40" />
        </padding>

        <HBox styleClass="top-bar" spacing="20" alignment="CENTER">
            <HBox styleClass="search-container" spacing="10" alignment="CENTER_LEFT"
                HBox.hgrow="ALWAYS">
                <ImageView fitWidth="20" fitHeight="20">
                    <Image url="@images/location-crosshairs.png" />
                </ImageView>
                <TextField styleClass="search-field" promptText="Search rooms or locations"
                    prefHeight="45" HBox.hgrow="ALWAYS" />
            </HBox>
            <HBox styleClass="user-icons" spacing="15" alignment="CENTER">
                <ImageView styleClass="notification-icon" fitWidth="24" fitHeight="24">
                    <Image url="@images/bell.png" />
                </ImageView>
                <ImageView styleClass="profile-icon" fitWidth="32" fitHeight="32">
                    <Image url="@images/user.png" />
                </ImageView>
            </HBox>
        </HBox>

        <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" />

    </VBox>
</AnchorPane>