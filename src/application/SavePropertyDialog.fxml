<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 15;"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.SavePropertyDialogController">

    <Label text="Save to Collections" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #113970;"/>
    <Label text="Choose the collection for this property:" style="-fx-text-fill: #666;"/>

    <fx:define>
        <ToggleGroup fx:id="categoryGroup"/>
    </fx:define>

    <VBox spacing="10">
        <RadioButton fx:id="checkCampus" text="Near Campus" toggleGroup="$categoryGroup" style="-fx-cursor: hand;"/>
        <RadioButton fx:id="checkPremium" text="Premium Options" toggleGroup="$categoryGroup" style="-fx-cursor: hand;"/>
        <RadioButton fx:id="checkBudget" text="Budget Picks" toggleGroup="$categoryGroup" style="-fx-cursor: hand;"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <padding><Insets top="10"/></padding>
        <Button fx:id="btnRemove" text="Remove from Saved" onAction="#handleRemove" visible="false" managed="false"
                style="-fx-background-color: #fdecea; -fx-text-fill: #c62828; -fx-cursor: hand;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancel" onAction="#handleCancel" style="-fx-background-color: #f0f0f0; -fx-cursor: hand;"/>
        <Button text="Save" onAction="#handleSave"
                style="-fx-background-color: #113970; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>
</VBox>