<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="1440" prefHeight="1024"
            stylesheets="@LandlordDashboard.css"
            styleClass="LANDLORD">

    <!-- Sidebar -->
    <Pane layoutX="0" layoutY="0" prefWidth="250" prefHeight="1024" styleClass="group"/>

    <!-- Sidebar Logo -->
    <HBox layoutX="20" layoutY="20" spacing="10" alignment="CENTER_LEFT" styleClass="div">
        <ImageView fx:id="logoImage" styleClass="image"
                   fitWidth="64" fitHeight="64"
                   pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@images/image-7.png"/>
            </image>
        </ImageView>
        <Label text="SMART STAY" styleClass="text-wrapper"/>
    </HBox>

    <!-- Sidebar Menu -->
    <VBox layoutX="30" layoutY="120" spacing="20">
        <Label text="Overview" styleClass="menu-item"/>
        <Label text="Tenants" styleClass="menu-item"/>
        <Label text="Applications" styleClass="menu-item"/>
        <Label text="Message" styleClass="menu-item"/>
        <Label text="Settings" styleClass="menu-item"/>
        <Label text="My Properties" styleClass="menu-item-bold"/>
    </VBox>

    <!-- Top Header Bar -->
    <AnchorPane layoutX="250" layoutY="0" prefWidth="1190" prefHeight="80" styleClass="top-header">
        <Label text="Landlord" layoutX="20" layoutY="25" styleClass="header-text"/>
        <StackPane layoutX="1050" layoutY="15" prefWidth="120" prefHeight="50">
            <Pane styleClass="add-property-btn"/>
            <HBox alignment="CENTER" spacing="5">
                <padding>
                    <Insets top="0" right="0" bottom="0" left="0"/>
                </padding>
                <Label text="+" styleClass="add-property-plus"/>
                <Label text="Add Property" styleClass="add-property-text"/>
            </HBox>
        </StackPane>
    </AnchorPane>

    <!-- Welcome Message -->
    <VBox layoutX="300" layoutY="100" spacing="5" styleClass="welcome-message">
        <Label text="Hello Landlord!" styleClass="text-wrapper-2"/>
        <Label text="Here's what's happening with your properties today." wrapText="true" styleClass="here-s-what-s"/>
    </VBox>

    <!-- Cards Row -->
    <HBox layoutX="300" layoutY="250" spacing="20">
        <!-- New Properties -->
        <StackPane styleClass="group-card" prefWidth="200" prefHeight="150">
            <Pane styleClass="rectangle-4"/>
            <Pane styleClass="rectangle-5"/>
            <VBox alignment="TOP_LEFT" spacing="10">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <Label text="8" styleClass="text-wrapper-7"/>
                <Label text="+2 this month" styleClass="text-wrapper-6"/>
            </VBox>
        </StackPane>

        <!-- Active Tenants / Total Properties -->
        <StackPane styleClass="group-card" prefWidth="200" prefHeight="150">
            <Pane styleClass="rectangle-6"/>
            <Pane styleClass="rectangle-7"/>
            <VBox alignment="TOP_LEFT" spacing="10">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <Label text="Active Tenants" styleClass="text-wrapper-8"/>
                <Label text="Total Properties" styleClass="text-wrapper-9"/>
                <Label text="24" styleClass="text-wrapper-11"/>
                <Label text="89% occupancy" styleClass="text-wrapper-10"/>
            </VBox>
        </StackPane>

        <!-- Monthly Revenue -->
        <StackPane styleClass="group-card" prefWidth="200" prefHeight="150">
            <Pane styleClass="rectangle-8"/>
            <Pane styleClass="rectangle-9"/>
            <VBox alignment="TOP_LEFT" spacing="10">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <Label text="Monthly Revenue" styleClass="text-wrapper-12"/>
                <Label text="+12% from last month" styleClass="text-wrapper-13"/>
                <Label text="₱84,600" styleClass="text-wrapper-14"/>
            </VBox>
        </StackPane>

        <!-- Pending Applications -->
        <StackPane styleClass="group-card" prefWidth="200" prefHeight="150">
            <Pane styleClass="rectangle-8"/>
            <Pane styleClass="rectangle-10"/>
            <VBox alignment="TOP_LEFT" spacing="10">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <Label text="Pending Applications" styleClass="text-wrapper-15"/>
                <Label text="3 new today" styleClass="text-wrapper-16"/>
                <Label text="5" styleClass="text-wrapper-17"/>
            </VBox>
        </StackPane>
    </HBox>

    <!-- Recent Activity -->
    <StackPane layoutX="300" layoutY="430" prefWidth="700" prefHeight="250" styleClass="group-8">
        <Pane styleClass="rectangle-11"/>
        <Pane styleClass="rectangle-12"/>
        <Pane styleClass="rectangle-13"/>
        <VBox spacing="20">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label text="Recent Activity" styleClass="text-wrapper-24"/>
            <HBox spacing="50">
                <VBox spacing="10">
                    <Label text="New Application from Shayne Digo" styleClass="text-wrapper-25"/>
                    <Label text="Payment received from Pete Petero" styleClass="text-wrapper-18"/>
                </VBox>
                <VBox spacing="10">
                    <Label text="Cozy Student Room" styleClass="text-wrapper-19"/>
                    <Label text="Modern Boarding House" styleClass="text-wrapper-20"/>
                </VBox>
                <VBox spacing="10">
                    <Label text="2 hours ago" styleClass="text-wrapper-21"/>
                    <Label text="6 hours ago" styleClass="text-wrapper-22"/>
                </VBox>
            </HBox>
        </VBox>
    </StackPane>

    <!-- Extra Info -->
    <HBox layoutX="300" layoutY="700" spacing="20">
        <Pane prefWidth="100" prefHeight="50" styleClass="rectangle-14"/>
        <Pane prefWidth="100" prefHeight="50" styleClass="rectangle-15"/>
        <Label text="Extra Info" styleClass="text-wrapper-26"/>
    </HBox>

</AnchorPane>
