<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="main-content-background" stylesheets="@LandlordMessages.css">

    <VBox spacing="5.0">
        <padding>
            <Insets bottom="20.0" left="40.0" right="40.0" top="40.0" />
        </padding>
        <Label styleClass="page-title" text="Messages" />
        <Label styleClass="page-subtitle" text="Communicate with tenants and applicants" />
    </VBox>

    <HBox styleClass="chat-card" VBox.vgrow="ALWAYS">
        <VBox.margin>
            <Insets bottom="40.0" left="40.0" right="40.0" />
        </VBox.margin>

        <VBox minWidth="350.0" prefWidth="350.0" styleClass="sidebar-container">

            <VBox alignment="CENTER" styleClass="search-container">
                <TextField promptText="Search conversations" styleClass="search-field" />
            </VBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="sidebar-scroll" VBox.vgrow="ALWAYS">
                <VBox spacing="0">

                    <HBox styleClass="conversation-item, active-item">
                        <VBox HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label styleClass="conv-name" text="Shayne Digo" />
                                <Pane HBox.hgrow="ALWAYS" />
                                <Label styleClass="conv-time" text="10:15 AM" />
                            </HBox>
                            <Label styleClass="conv-preview" text="Good morning! Just checking..." />
                        </VBox>
                    </HBox>

                    <HBox styleClass="conversation-item">
                        <VBox HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label styleClass="conv-name" text="Pete Petero" />
                                <Pane HBox.hgrow="ALWAYS" />
                                <Label styleClass="conv-time" text="10:20 AM" />
                            </HBox>
                            <Label styleClass="conv-preview" text="The WiFi is working now..." />
                        </VBox>
                    </HBox>

                    <HBox styleClass="conversation-item">
                        <VBox HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label styleClass="conv-name" text="Aljon Macunte" />
                                <Pane HBox.hgrow="ALWAYS" />
                                <Label styleClass="conv-time" text="10:23 AM" />
                            </HBox>
                            <Label styleClass="conv-preview" text="Is the room still available..." />
                        </VBox>
                    </HBox>

                </VBox>
            </ScrollPane>
        </VBox>

        <VBox styleClass="chat-area" HBox.hgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT" styleClass="chat-header">
                <Label styleClass="chat-header-name" text="Shayne Digo" />
                <Pane HBox.hgrow="ALWAYS" />
                <Label styleClass="menu-icon" text="⋮" />
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="messages-scroll" VBox.vgrow="ALWAYS">
                <VBox spacing="20.0" styleClass="messages-container">

                    <HBox alignment="CENTER_LEFT" styleClass="msg-row">
                        <VBox styleClass="msg-bubble, incoming">
                            <Label wrapText="true" text="Good morning! Just checking if the payment is due today?" />
                        </VBox>
                    </HBox>
                    <Label styleClass="timestamp-left" text="10:15 AM" />

                    <HBox alignment="CENTER_RIGHT" styleClass="msg-row">
                        <VBox styleClass="msg-bubble, outgoing">
                            <Label wrapText="true" text="Yes, the rent is due today. Please send it before 5 PM." />
                        </VBox>
                    </HBox>
                    <Label styleClass="timestamp-right" text="10:20 AM" />

                    <HBox alignment="CENTER_LEFT" styleClass="msg-row">
                        <VBox styleClass="msg-bubble, incoming">
                            <Label wrapText="true" text="Thank you! I will send the payment today." />
                        </VBox>
                    </HBox>
                    <Label styleClass="timestamp-left" text="10:23 AM" />

                </VBox>
            </ScrollPane>

            <HBox alignment="CENTER" spacing="15.0" styleClass="input-area">
                <TextField promptText="Type a message..." styleClass="input-field" HBox.hgrow="ALWAYS" />
                <Button styleClass="send-button" text="➤" />
            </HBox>
        </VBox>

    </HBox>
</VBox>