<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
           fx:id="rootPane"
           fx:controller="application.HomepageController"
           stylesheets="@application.css"
           prefWidth="1400"
           prefHeight="750"
           styleClass="landing-page-container1">

    <!-- Background Color -->
    <Region styleClass="landing-page-landing-page" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" 
            AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0"/>

    <!-- Background Circle (Top Left) -->
    <Circle fx:id="bgCircle"
            styleClass="landing-page-e11"
            radius="260"
            fill="#125A8B"
            opacity="0.15"/>

    <!-- Hero Image (image8) -->
    <ImageView fx:id="heroImage"
               styleClass="landing-page-image8"
               fitWidth="657"
               fitHeight="657"
               preserveRatio="true"
               pickOnBounds="false"
               smooth="true"
               layoutX="720"
               layoutY="75"/>

    <!-- Decorative Circle (Bottom Right) -->
    <Circle fx:id="decorativeImage"
            styleClass="landing-page-e12"
            radius="330"
            fill="#125A8B"
            opacity="0.15"/>

    <!-- Logo Group (group29) - aligned with navigation -->
    <HBox fx:id="logoGroup" styleClass="landing-page-group29" spacing="12" alignment="CENTER_LEFT"
          layoutX="188" layoutY="57" prefWidth="291" prefHeight="52">
        <ImageView fx:id="logoImage"
                   styleClass="landing-page-image7"
                   fitWidth="45"
                   fitHeight="45"
                   preserveRatio="true"
                   pickOnBounds="false"
                   smooth="true"/>
        <Label text="STAY SMART" styleClass="landing-page-text23"/>
    </HBox>

    <!-- Navigation Labels -->
    <Label fx:id="homeLabel" text="Home" styleClass="landing-page-text10" layoutX="556" layoutY="57"/>
    <Label fx:id="pricingLabel" text="Pricing" styleClass="landing-page-text11" layoutX="683" layoutY="57"/>
    <Label fx:id="contactLabel" text="Contact" styleClass="landing-page-text12" layoutX="799" layoutY="57"/>
    <Label fx:id="aboutLabel" text="About us" styleClass="landing-page-text14" layoutX="912" layoutY="57"/>

    <!-- Login Button -->
    <Button fx:id="loginButton" 
            text="LOG IN" 
            styleClass="landing-page-button1" 
            onAction="#onLoginButtonClick"
            layoutX="1029"
            layoutY="46"/>

    <!-- Sign Up Button -->
    <Button fx:id="signupButton" 
            text="SIGN UP" 
            styleClass="landing-page-button2" 
            onAction="#onSignupButtonClick"
            layoutX="1183"
            layoutY="46"/>

    <!-- Hero Text Section -->
    <VBox fx:id="heroTextSection" styleClass="landing-page-hero2" spacing="0"
          layoutX="191" layoutY="231" prefWidth="601" prefHeight="167">
        <Text styleClass="landing-page-text18" text="Simplify your&#10;Boarding House"/>
    </VBox>

    <!-- Body Text -->
    <Text fx:id="bodyText" styleClass="landing-page-text17 BodyText"
          layoutX="425" layoutY="1095" wrappingWidth="595"
          text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut"/>

    <!-- Get Started Button -->
    <Button fx:id="getStartedButton" onAction="#onSignupButtonClick" text="GET STARTED TODAY" 
            styleClass="landing-page-button3"
            layoutX="191"
            layoutY="480"/>

    <!-- Most Viewed Section -->
    <VBox fx:id="mostViewedSection" styleClass="landing-page-hero1" alignment="CENTER_LEFT"
          layoutX="593" layoutY="1011" prefWidth="279" prefHeight="84">
        <Label text="Most Viewed" styleClass="landing-page-text13"/>
    </VBox>

</AnchorPane>
