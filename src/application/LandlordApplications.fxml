<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fitToWidth="true"
            style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0; -fx-background-insets: 0;"
            stylesheets="@LandlordApplications.css">

    <content>
        <VBox spacing="25" style="-fx-background-color: transparent;">

            <padding>
                <Insets top="50" right="40" bottom="40" left="40"/>
            </padding>

            <VBox spacing="5">
                <Label text="Applications" styleClass="page-title"/>
                <Label text="You have 3 pending applications" styleClass="page-subtitle"/>
            </VBox>

            <HBox spacing="20" alignment="CENTER_LEFT">

                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <StackPane styleClass="icon-bg-pending">
                            <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                                <image><Image url="@images/icon-pending.png"/></image>
                            </ImageView>
                        </StackPane>
                        <Label text="Pending" styleClass="stat-label"/>
                    </HBox>
                    <Label text="3" styleClass="stat-number"/>
                </VBox>

                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <StackPane styleClass="icon-bg-approved">
                            <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                                <image><Image url="@images/icon-check.png"/></image>
                            </ImageView>
                        </StackPane>
                        <Label text="Approved" styleClass="stat-label"/>
                    </HBox>
                    <Label text="1" styleClass="stat-number"/>
                </VBox>

                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <StackPane styleClass="icon-bg-rejected">
                            <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                                <image><Image url="@images/icon-cross.png"/></image>
                            </ImageView>
                        </StackPane>
                        <Label text="Rejected" styleClass="stat-label"/>
                    </HBox>
                    <Label text="1" styleClass="stat-number"/>
                </VBox>
            </HBox>

            <VBox styleClass="application-card" spacing="15">
                <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

                <HBox spacing="15" alignment="CENTER_LEFT">
                    <ImageView fitWidth="50" fitHeight="50" preserveRatio="true">
                        <clip><Circle centerX="25" centerY="25" radius="25"/></clip>
                        <image><Image url="@images/profile.png"/></image>
                    </ImageView>

                    <VBox spacing="2">
                        <Label text="Shayne Digo" styleClass="applicant-name"/>
                        <Label text="shaynedigo31@gmail.com" styleClass="applicant-email"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="2 hours ago" styleClass="timestamp-text"/>
                </HBox>

                <HBox spacing="5" alignment="BASELINE_LEFT">
                    <Label text="Applied for:" styleClass="label-gray"/>
                    <Label text="Cozy Student Room" styleClass="link-purple"/>
                </HBox>

                <VBox styleClass="message-box" spacing="5">
                    <Label text="Message:" styleClass="label-gray"/>
                    <Label text="I am a 2nd year college student looking for a quiet place to stay near campus."
                           styleClass="message-text" wrapText="true"/>
                </VBox>

                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Button text="Approved" styleClass="btn-action, btn-approve" prefWidth="150"/>
                    <Button text="Reject" styleClass="btn-action, btn-reject" prefWidth="150"/>
                    <Button text="Contact" styleClass="btn-action, btn-contact" prefWidth="120"/>
                </HBox>
            </VBox>

        </VBox>
    </content>
</ScrollPane>